# Copy to .env. Never commit .env or place credentials in frontend code.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_STYLE=ollama
LLM_MODEL=qwen3:8b
LLM_API_KEY=
TOOL_BACKEND=local
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=
RAGFLOW_SYNTHETIC_DATASET_IDS=
RAGFLOW_RESEARCH_DATASET_IDS=
RAGFLOW_ENTITY_DATASET_IDS=
RAGFLOW_FUNCTION_DOCUMENT_IDS=
RAGFLOW_EMBEDDING_MODEL=
RAGFLOW_RERANK_ID=
RAGFLOW_RERANK_THRESHOLD=0.05
DIFY_BASE_URL=http://127.0.0.1:8081/v1
DIFY_AGENT_API_KEY=
DIFY_TOOL_KEYS_FILE=
# Optional native-loop key file for host execution; Docker uses native.override.yaml.
# Generate with scripts/bootstrap_native_workflows.py; never copy keys into this file.
DIFY_NATIVE_MAIN_KEYS_FILE=
DIFY_NATIVE_DIAGNOSIS_KEYS_FILE=
# Generated by scripts/configure.py; keep these values private.
INTERNAL_TOOL_TOKEN=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# Empty means local SQLite. Compose configures PostgreSQL separately.
DATABASE_URL=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
GRAPH_BACKEND=local
READ_KB_FROM_POSTGRES=false
SENSITIVE_DEMO_WORDS=诊断演示敏感词

